# --- LLM providers ------------------------------------------------------------
# Ordered fallback chain. The first provider with a key is used; on rate limits,
# server errors or timeouts the next one takes over. Options: gemini, groq, openai, ollama, mock
LLM_PROVIDERS=gemini,groq

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high — empty to use the model default
GEMINI_REASONING_EFFORT=low

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: run fully locally and privately with Ollama (add "ollama" to LLM_PROVIDERS)
# ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Web ------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. to allow Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://resume-customizer-.*\.vercel\.app
RATE_LIMIT_PER_MINUTE=12

# --- Auth & storage --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# SQLite works locally. For durable hosted history use Postgres (e.g. Neon free tier):
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=sqlite:///./resume_customizer.db

# --- Limits ------------------------------------------------------------------------
MAX_UPLOAD_MB=5
